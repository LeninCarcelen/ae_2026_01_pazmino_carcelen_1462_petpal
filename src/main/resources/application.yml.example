spring:
  application:
    name: petpal

  datasource:
    url: jdbc:h2:mem:petpal;DB_CLOSE_DELAY=-1
    driver-class-name: org.h2.Driver
    username: sa
    password: ""

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  h2:
    console:
      enabled: true
      path: /h2-console

  # --- AWS Cognito ---
  # User Pool: "User pool - rvyxw-" (us-east-1_YHlWgVU4H, region us-east-1)
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: https://cognito-idp.us-east-1.amazonaws.com/us-east-1_YHlWgVU4H

server:
  port: 8080

springdoc:
  swagger-ui:
    path: /swagger-ui.html
